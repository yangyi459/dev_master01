# 悦芽口腔 后端环境变量模板（api/.env）
# 复制为 .env 后按需修改；.env 不入库（已在 .gitignore 规划内）

# ---- 数据库 ----
# SQLite 单文件，位于 api/data/app.db
DATABASE_URL=sqlite:///./data/app.db

# ---- JWT 密钥（生产务必替换为强随机值）----
JWT_SECRET=dev-secret-change-me-please-use-strong-random
# 家长 JWT 有效期（分钟）：7 天 = 10080
PARENT_JWT_EXPIRE_MINUTES=10080
# 管理员 JWT 有效期（分钟）：8 小时 = 480
ADMIN_JWT_EXPIRE_MINUTES=480
# 算法
JWT_ALGORITHM=HS256

# ---- CORS（仅放行两个前端域名，禁止 * 通配，见 §20 坑位 15）----
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- 上传与静态资源 ----
# 上传图片物理落盘目录（相对 api/ 根）
UPLOAD_DIR=./uploads
# 响应层图片前缀（库里只存 uploads/... 逻辑路径，响应时拼成 /media/uploads/...）
MEDIA_BASE_URL=/media

# ---- 高德地图（M3 门店分布用，未配则前端优雅降级）----
AMAP_JS_KEY=

# ---- 短信通道（M2 接入，本期留空不影响跑通）----
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

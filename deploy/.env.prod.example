# 悦芽口腔 后端 · 生产环境变量模板
# 复制为 api/.env 后：① 改 JWT_SECRET 为强随机 ② 改 CORS_ORIGINS 为真实域名 ③ SQLITE_WAL=true
# 注意：本文件仅作占位，生产不要把真实密钥提交进 git（api/.env 已在 .gitignore 规划内）。

# ---- 数据库 ----
DATABASE_URL=sqlite:///./data/app.db
# 生产启用 WAL 提升并发；若服务器拦截 -wal/-shm 写入（如某些沙箱/Defender 场景）改 false
SQLITE_WAL=true

# ---- JWT（生产务必替换 JWT_SECRET：openssl rand -hex 32）----
JWT_SECRET=CHANGE_ME_TO_STRONG_RANDOM_OPENSSL_RAND_HEX_32
PARENT_JWT_EXPIRE_MINUTES=10080
ADMIN_JWT_EXPIRE_MINUTES=480
JWT_ALGORITHM=HS256

# ---- CORS（仅放行两个前端域名，禁止 * 通配，见方案 §20 坑位 15）----
CORS_ORIGINS=https://www.yueya.example.com,https://admin.yueya.example.com

# ---- 上传与静态资源 ----
UPLOAD_DIR=./uploads
MEDIA_BASE_URL=/media

# ---- 高德地图（配后前台门店分布地图真正加载；留空则优雅降级占位）----
AMAP_JS_KEY=

# ---- 短信通道（M2 预留，本期留空不影响跑通）----
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
